# Copy the lines you need into your shell. No password is needed: Windows Authentication is used.
# PowerShell:  $env:ADY_SQL_SERVER = "localhost\SQLEXPRESS"
ADY_SQL_SERVER=localhost\SQLEXPRESS
ADY_SQL_DATABASE=ADY201m_Report2
ADY_SQL_TEST_DATABASE=ADY201m_Report2_Test
ADY_SQL_DRIVER=ODBC Driver 18 for SQL Server
# Set to 1 to run the SQL Server tests in tests/python/test_storage.py
ADY_RUN_DB_TESTS=1
# Keep Playwright's Chromium inside .venv
PLAYWRIGHT_BROWSERS_PATH=0
